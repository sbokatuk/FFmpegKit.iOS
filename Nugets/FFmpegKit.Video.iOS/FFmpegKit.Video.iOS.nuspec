<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>FFmpegKit.Video.iOS</id>
    <title>.NET (net8.0-ios) bindings to the native iOS FFmpegKit Video SDK.</title>
    <version>4.5.1</version>
    <authors>s.bokatuk</authors>
    <owners>s.bokatuk</owners>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/sbokatuk/FFmpegKit.iOS</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>net8.0-ios bindings to the native FFmpegKit Video (non-GPL) SDK, for consumption from .NET MAUI / net8.0-ios projects.</description>
    <summary>.NET MAUI / net8.0-ios bindings to the native FFmpegKit Video SDK.</summary>
    <tags>ffmpeg ffmpegkit video SDK maui net8.0-ios Binding</tags>
    <icon>images/icon.png</icon>
    <releaseNotes>

nuget sources repository:
https://github.com/sbokatuk/FFmpegKit.iOS

    </releaseNotes>
  </metadata>
  <files>
    <file src="lib/net8.0-ios18.0/*.dll" target="lib/net8.0-ios18.0" />
    <file src="lib/net8.0-ios18.0/*.resources.zip" target="lib/net8.0-ios18.0" />
    <file src="../icon.png" target="images/" />
    <file src="README.txt" target="" />
  </files>
</package>
