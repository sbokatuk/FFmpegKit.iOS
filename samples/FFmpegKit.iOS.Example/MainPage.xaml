<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FFmpegKitExample.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label
                Text="FFmpegKit.iOS — Binding Demo"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Source Video"
                FontSize="16"
                FontAttributes="Bold" />

            <toolkit:MediaElement
                x:Name="SourcePlayer"
                HeightRequest="220"
                ShouldAutoPlay="False"
                ShouldShowPlaybackControls="True" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    x:Name="ResizeButton"
                    Grid.Column="0"
                    Text="Resize"
                    Clicked="OnResizeClicked" />
                <Button
                    x:Name="GrayscaleButton"
                    Grid.Column="1"
                    Text="Grayscale"
                    Clicked="OnGrayscaleClicked" />
                <Button
                    x:Name="ExtractAudioButton"
                    Grid.Column="2"
                    Text="Extract Audio"
                    Clicked="OnExtractAudioClicked" />
            </Grid>

            <Button
                x:Name="CancelButton"
                Text="Cancel"
                IsEnabled="False"
                Clicked="OnCancelClicked" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

            <ProgressBar x:Name="Progress" Progress="0" IsVisible="False" />

            <Label
                x:Name="StatusLabel"
                Text="Ready to start."
                FontSize="13"
                TextColor="Gray" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label
                Text="Processing Result"
                FontSize="16"
                FontAttributes="Bold" />

            <toolkit:MediaElement
                x:Name="ResultPlayer"
                HeightRequest="220"
                ShouldAutoPlay="False"
                ShouldShowPlaybackControls="True" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
