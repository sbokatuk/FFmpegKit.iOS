<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Each .NET SDK's iOS workload supports the current TFM and the previous one: the .NET 9 band
      builds net8.0-ios + net9.0-ios, the .NET 10 band builds net9.0-ios + net10.0-ios. No single
      SDK can build all three, so BuildNugets.sh packs twice and merges the results - see
      build/merge-packages.py. FFmpegKitSdkBand selects which pass this build is.

      The platform version is pinned rather than left to the workload's default, because it ends
      up in the lib/<tfm>/ folder name inside the package: an unpinned net8.0-ios silently became
      lib/net8.0-ios18.0/, and a workload update that moved that default would change the
      package's advertised target frameworks without a single source edit.
    -->
    <FFmpegKitSdkBand Condition=" '$(FFmpegKitSdkBand)' == '' ">net9</FFmpegKitSdkBand>
    <TargetFrameworks Condition=" '$(FFmpegKitSdkBand)' == 'net9' ">net8.0-ios18.0;net9.0-ios18.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(FFmpegKitSdkBand)' == 'net10' ">net10.0-ios26.0</TargetFrameworks>
    <!--
      net8.0-ios is past end of support, which the SDK reports as an error/warning. It ships
      deliberately: .NET 8 is still where a large share of MAUI apps are.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <IsBindingProject>true</IsBindingProject>
    <!--
      Ship the native payload as a single Assembly.resources.zip rather than an
      Assembly.resources directory. The default is 'auto', which compresses only when the
      xcframeworks contain symlinks - true while they still carried the macOS slice, false once
      FetchXcFrameworks.sh strips it. The directory form is supported by the consuming SDK, but
      it puts ~1000 files into the package at paths like
      lib/net8.0-ios18.0/<assembly>.resources/ffmpegkit.xcframework/ios-arm64_x86_64-simulator/
      ffmpegkit.framework/Headers/MediaInformationSessionCompleteCallback.h, which trips NU5123
      and can exceed the 260-character limit on Windows once the global packages folder is
      prepended - breaking restore for anyone in a MAUI solution without long path support.
    -->
    <CompressBindingResourcePackage>true</CompressBindingResourcePackage>
    <!--
      The namespace stays Ffmpegkit.Ios even though the package is now FFmpegKit.Net.*. A
      namespace rooted at "FFmpegKit" containing a type also called FFmpegKit makes every
      consumer call ambiguous - `FFmpegKit.Execute(...)` resolves the namespace first and fails
      with "'Execute' does not exist in the namespace 'FFmpegKit'".
    -->
    <RootNamespace>Ffmpegkit.Ios</RootNamespace>
    <AssemblyName>FFmpegKit.Net.$(FFmpegKitBuildType).iOS</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: the generated binding has no XML doc comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <Target Name="ValidateFFmpegKitSdkBand" BeforeTargets="Build;Pack"
          Condition=" '$(TargetFrameworks)' == '' ">
    <Error Text="FFmpegKitSdkBand must be 'net9' or 'net10', but was '$(FFmpegKitSdkBand)'." />
  </Target>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="Structs.cs" />
  </ItemGroup>

  <!--
    libs/ holds one directory per variant once FetchXcFrameworks.sh has run, so link only the
    set this build is for. ForceLoad and the system frameworks/libraries come from upstream's
    own integration instructions: ffmpegkit registers its symbols at load time, and the FFmpeg
    libraries pull in libc++, iconv, bz2 and zlib.
  -->
  <PropertyGroup>
    <FFmpegKitLibsDirectory>libs/$(FFmpegKitBuildType)</FFmpegKitLibsDirectory>
  </PropertyGroup>

  <Target Name="ValidateFFmpegKitLibs" BeforeTargets="Build;Pack"
          Condition="!Exists('$(MSBuildProjectDirectory)/$(FFmpegKitLibsDirectory)/ffmpegkit.xcframework')">
    <Error Text="No xcframeworks for '$(FFmpegKitBuildType)' in $(FFmpegKitLibsDirectory). Run ./FetchXcFrameworks.sh $(FFmpegKitNativeVersion) $(FFmpegKitBuildType) first." />
  </Target>

  <ItemGroup>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/ffmpegkit.xcframework">
      <Kind>Framework</Kind>
      <ForceLoad>True</ForceLoad>
      <IsCxx>True</IsCxx>
      <Frameworks>AudioToolbox AVFoundation CoreMedia VideoToolbox</Frameworks>
      <LinkerFlags>-lc++ -liconv -lbz2 -lz</LinkerFlags>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libavcodec.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libavdevice.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libavfilter.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libavformat.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libavutil.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libswresample.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FFmpegKitLibsDirectory)/libswscale.xcframework">
      <Kind>Framework</Kind>
      <IsCxx>True</IsCxx>
    </NativeReference>
  </ItemGroup>

  <!--
    Licensing follows the native binaries, not this repository. Upstream ships the -gpl variants
    under GPL-3.0 (x264/x265/xvid/vidstab are GPL) and everything else under LGPL-3.0; each
    xcframework carries the matching licence text at ffmpegkit.framework/LICENSE. Upstream states
    version 3.0 with no "or later" wording, hence the -only SPDX identifiers. The binding source
    itself is MIT, so the package as a whole is the conjunction of the two.
  -->
  <PropertyGroup>
    <FFmpegKitIsGpl>false</FFmpegKitIsGpl>
    <FFmpegKitIsGpl Condition="$(FFmpegKitBuildType.EndsWith('Gpl'))">true</FFmpegKitIsGpl>

    <FFmpegKitNativeLicense Condition=" '$(FFmpegKitIsGpl)' == 'true' ">GPL-3.0-only</FFmpegKitNativeLicense>
    <FFmpegKitNativeLicense Condition=" '$(FFmpegKitIsGpl)' != 'true' ">LGPL-3.0-only</FFmpegKitNativeLicense>

    <FFmpegKitNativeLicenseFile Condition=" '$(FFmpegKitIsGpl)' == 'true' ">../../licenses/GPL-3.0.txt</FFmpegKitNativeLicenseFile>
    <FFmpegKitNativeLicenseFile Condition=" '$(FFmpegKitIsGpl)' != 'true' ">../../licenses/LGPL-3.0.txt</FFmpegKitNativeLicenseFile>

    <!-- FullGpl -> full-gpl, HttpsGpl -> https-gpl, Video -> video, ... - used in package tags. -->
    <FFmpegKitVariantName>$(FFmpegKitBuildType.ToLowerInvariant().Replace('gpl', '-gpl'))</FFmpegKitVariantName>
  </PropertyGroup>

  <!-- Packaging -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>FFmpegKit.Net.$(FFmpegKitBuildType).iOS</PackageId>
    <Title>.NET for iOS bindings for the native FFmpegKit $(FFmpegKitBuildType) SDK.</Title>
    <Description>.NET for iOS / .NET MAUI bindings for the native FFmpegKit $(FFmpegKitBuildType) SDK. Built against FFmpeg $(FFmpegKitNativeVersion). The bundled native FFmpeg binaries are licensed under $(FFmpegKitNativeLicense); the binding code is MIT. See the licence files in this package before shipping.</Description>
    <PackageLicenseExpression>MIT AND $(FFmpegKitNativeLicense)</PackageLicenseExpression>
    <PackageTags>ffmpeg;ffmpegkit;$(FFmpegKitVariantName);video;audio;transcode;SDK;MAUI;iOS;dotnet-ios;Binding</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />

    <!--
      Ship both licence texts the package is covered by. Distributing LGPL/GPL binaries means
      conveying their terms, and a consumer should not have to unzip the framework to find them.
      Packed into a folder so each file keeps its own name - naming the target explicitly would
      make NuGet treat the extensionless LICENSE as a directory.
    -->
    <None Include="../../LICENSE" Pack="true" PackagePath="licenses/" Visible="false" />
    <None Include="$(FFmpegKitNativeLicenseFile)" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

</Project>
